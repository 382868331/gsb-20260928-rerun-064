{
  "version_set": "rules-2024-v1",
  "rules": [
    {
      "id": "identity_present",
      "type": "required_fields",
      "fields": ["id", "id_card"]
    },
    {
      "id": "identity_unique",
      "type": "unique_fields",
      "params": {"key_fields": ["id_card"]},
      "depends_on": ["identity_present"]
    },
    {
      "id": "employment_dates_consistent",
      "type": "date_order",
      "params": {
        "early_field": "hire_date",
        "late_field": "leave_date",
        "optional_fields": ["leave_date"]
      }
    }
  ]
}
